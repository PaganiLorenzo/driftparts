<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Drift Parts</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="/stylesheets/basic.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>

<body class="background">
    <%- include("./navbar.ejs") %>
    <div class="container mt-5 mb-5 text-purple">
        <h1 class="mb-4">My Cart</h1>
        <div class="row">
            <div class="col-md-8">
                <div class="card container cartscroll">
                    <div class="card mb-3">
                        <div class="card-body row">
                            <div class="col-md-2">
                                <img src="images/hks coilovers.webp" class="card-img mycart-img" alt="" />
                            </div>
                            <div class="col-md-10">
                                <h5 class="card-title">Product Name</h5>
                                <p class="card-text">Product Description</p>
                                <p class="card-text">Price: $XX.XX</p>
                                <button class="btn btn-danger btn-sm">Remove</button>
                            </div>
                        </div>
                    </div>
                    <div class="card mb-3">
                        <div class="card-body row">
                            <div class="col-md-2">
                                <img src="images/hks coilovers.webp" class="card-img mycart-img" alt="" />
                            </div>
                            <div class="col-md-10">
                                <h5 class="card-title">Product Name</h5>
                                <p class="card-text">Product Description</p>
                                <p class="card-text">Price: $XX.XX</p>
                                <button class="btn btn-danger btn-sm">Remove</button>
                            </div>
                        </div>
                    </div>
                    <div class="card mb-3">
                        <div class="card-body row">
                            <div class="col-md-2">
                                <img src="images/hks coilovers.webp" class="card-img mycart-img" alt="" />
                            </div>
                            <div class="col-md-10">
                                <h5 class="card-title">Product Name</h5>
                                <p class="card-text">Product Description</p>
                                <p class="card-text">Price: $XX.XX</p>
                                <button class="btn btn-danger btn-sm">Remove</button>
                            </div>
                        </div>
                    </div>
                    <div class="card mb-3">
                        <div class="card-body row">
                            <div class="col-md-2">
                                <img src="images/hks coilovers.webp" class="card-img mycart-img" alt="" />
                            </div>
                            <div class="col-md-10">
                                <h5 class="card-title">Product Name</h5>
                                <p class="card-text">Product Description</p>
                                <p class="card-text">Price: $XX.XX</p>
                                <button class="btn btn-danger btn-sm">Remove</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Cart Summary</h5>
                        <ul class="list-group">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Subtotal:
                                <span>$XX.XX</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Tax:
                                <span>$XX.XX</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                Total:
                                <span>$XX.XX</span>
                            </li>
                        </ul>
                        <button class="btn btn-primary btn-block mt-3">Checkout</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer footer-style">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4">
                    <h5>Free Shipping</h5>
                    <p><i class="fas fa-truck"></i> Free shipping on all orders</p>
                </div>
                <div class="col-md-4">
                    <h5>Contacts</h5>
                    <p><i class="fas fa-phone"></i> Call us: +39 0322 758 9970</p>
                    <p><i class="fas fa-envelope"></i> Email us: driftparts@gmail.com</p>
                </div>
                <div class="col-md-4">
                    <h5>30 Days Returns</h5>
                    <p><i class="fas fa-undo"></i> Easy returns within 30 days</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>

