<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Drift Parts</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/stylesheets/basic.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>

<body class="background">
<%- include("./navbar.ejs") %>

<div class="container mt-5 mb-5 text-purple">
    <h1 class="mb-4">My Cart</h1>

    <div class="row">

        <!-- CART ITEMS -->
        <div class="col-md-8">

            <div class="card container cartscroll p-3">

                <% if (!products || products.length === 0) { %>
                    <p class="text-center">Your cart is empty</p>
                <% } %>

                <% products.forEach(product => { %>

                    <div class="card mb-3 cart-item" data-id="<%= product.ID %>">
                        <div class="card-body row align-items-center">

                            <div class="col-md-2">
                                <img src="<%= product.ImagePath %>.jpg"
                                     class="card-img mycart-img"
                                     alt="<%= product.Name %>">
                            </div>

                            <div class="col-md-8">
                                <h5 class="card-title"><%= product.Name %></h5>
                                <p class="card-text">
                                    Price: € <%= product.Price %>
                                </p>
                                <p class="card-text">
                                    Quantity: <strong><%= product.quantity %></strong>
                                </p>
                            </div>

                            <div class="col-md-2 text-end">
                                <button class="btn btn-danger btn-sm remove-from-cart"
                                        data-id="<%= product.ID %>">
                                    Remove
                                </button>
                            </div>

                        </div>
                    </div>

                <% }) %>

            </div>

        </div>

        <!-- SUMMARY -->
        <div class="col-md-4">

            <div class="card">
                <div class="card-body">

                    <h5 class="card-title">Cart Summary</h5>

                    <ul class="list-group">

                        <%
                            let subtotal = 0;
                            products.forEach(p => {
                                subtotal += p.Price * p.quantity;
                            });
                            let tax = subtotal * 0.22;
                            let total = subtotal + tax;
                        %>

                        <li class="list-group-item d-flex justify-content-between">
                            Subtotal:
                            <span>€ <%= subtotal.toFixed(2) %></span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between">
                            Tax (22%):
                            <span>€ <%= tax.toFixed(2) %></span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between">
                            Total:
                            <span><strong>€ <%= total.toFixed(2) %></strong></span>
                        </li>

                    </ul>

                    <button class="btn btn-primary w-100 mt-3">
                        Checkout
                    </button>

                </div>
            </div>

        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>
<script src = "/javascripts/cart.js"></script>

</body>
</html>