<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Drift Parts</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="/stylesheets/basic.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>

<body class="background">

    <%- include("./navbar.ejs") %>

        <div class="container mt-4">

            <h1 class="text-center text-white mb-5">
                <%= category %>
            </h1>

            <div class="row">

                <% if (articles.length===0) { %>

                    <div class="col-12 text-center text-white">

                        <h3>No articles found</h3>

                    </div>

                    <% } %>

                        <% articles.forEach(article=> { %>

                            <div class="col-md-3 mb-4">

                                <div class="card h-100 shadow">

                                    <img src="<%= article.ImagePath %>.jpg" class="card-img-top"
                                        alt="<%= article.Name %>">

                                    <div class="card-body d-flex flex-column">

                                        <h5 class="card-title">
                                            <%= article.Name %>
                                        </h5>

                                        <p class="card-text">
                                            € <%= article.Price %>
                                        </p>

                                        <button class="btn btn-dark mt-auto add-to-cart" data-id="<%= article.ID %>">

                                            Add to cart

                                        </button>

                                    </div>

                                </div>

                            </div>

                            <% }) %>

            </div>

        </div>

        <footer class="footer footer-style mt-5">

            <div class="container">

                <div class="row text-center">

                    <div class="col-md-4">

                        <h5>Free Shipping</h5>

                        <p>
                            <i class="fas fa-truck"></i>
                            Free shipping on all orders
                        </p>

                    </div>

                    <div class="col-md-4">

                        <h5>Contacts</h5>

                        <p>
                            <i class="fas fa-phone"></i>
                            Call us: +39 0322 758 9970
                        </p>

                        <p>
                            <i class="fas fa-envelope"></i>
                            Email us: driftparts@gmail.com
                        </p>

                    </div>

                    <div class="col-md-4">

                        <h5>30 Days Returns</h5>

                        <p>
                            <i class="fas fa-undo"></i>
                            Easy returns within 30 days
                        </p>

                    </div>

                </div>

            </div>

        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/javascripts/cart.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>

</body>

</html>