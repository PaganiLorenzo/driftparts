<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Drift Parts</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="/stylesheets/basic.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>

<body class="background">
    <%- include("./navbar.ejs") %>
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="white-container p-4 article-box">
                    <img src="images/recaro-pole-pos.jpg" class="img-fluid" alt="Recaro seats">
                    <h1 class="mt-3">Recaro seats</h1>
                    <h2>750 $</h2>
                    <h5>Description</h5>
                    <div class="d-flex justify-content-between mt-3">
                        <button class="btn btn-primary">Buy Now</button>
                        <button class="btn btn-success">Add to Cart</button>
                    </div>
                    <form class="mt-3">
                        <div class="mb-3">
                            <label for="comment" class="form-label">Leave a comment</label>
                            <textarea class="form-control" id="comment" rows="3"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </form>
                    <div class="card mt-3">
                        <div class="card-body">
                            <h5 class="card-title">Your ID</h5>
                            <p class="card-text">Your review here</p>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-secondary mt-3 mb-3">Cancel</button>
                    <div class="card-container reviews">
                        <div class="card mt-3">
                            <div class="card-body">
                                <h5 class="card-title">User ID</h5>
                                <p class="card-text">Other user review.</p>
                            </div>
                        </div>
                        <div class="card mt-3">
                            <div class="card-body">
                                <h5 class="card-title">User ID</h5>
                                <p class="card-text">Other user review.</p>
                            </div>
                        </div>
                        <div class="card mt-3">
                            <div class="card-body">
                                <h5 class="card-title">User ID</h5>
                                <p class="card-text">Other user review.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer footer-style">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4">
                    <h5>Free Shipping</h5>
                    <p><i class="fas fa-truck"></i> Free shipping on all orders</p>
                </div>
                <div class="col-md-4">
                    <h5>Contacts</h5>
                    <p><i class="fas fa-phone"></i> Call us: +39 0322 758 9970</p>
                    <p><i class="fas fa-envelope"></i> Email us: driftparts@gmail.com</p>
                </div>
                <div class="col-md-4">
                    <h5>30 Days Returns</h5>
                    <p><i class="fas fa-undo"></i> Easy returns within 30 days</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>
</body>

</html>
