                    <div class="col-md-4">
                        <h5>Free Shipping</h5>
                        <p><i class="fas fa-truck"></i> Free shipping on all orders</p>
                    </div>
                    <div class="col-md-4">
                        <h5>Contacts</h5>
                        <p><i class="fas fa-phone"></i> Call us: +39 0322 758 9970</p>
                        <p><i class="fas fa-envelope"></i> Email us: driftparts@gmail.com</p>
                    </div>
                    <div class="col-md-4">
                        <h5>30 Days Returns</h5>
                        <p><i class="fas fa-undo"></i> Easy returns within 30 days</p>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
